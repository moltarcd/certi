?section movetop macro
== MACRO PARA DUPLICAR A PRODUCCION
#frame
   #push #INLINEPREFIX
   #push dest_vol
   #push orig_vol
   #set #INLINEPREFIX +
   == Adjust to set the Production destination vol and subvol
   #set dest_vol \BNLCC.$DUFFY.NEWBOBJ
   #set orig_vol \BNLCC.$DUFFY.CAFREP
   fup/inline/
      + dup [orig_vol].CAFEEXT  , [dest_vol].*, sourcedate
      + dup [orig_vol].CAFEEXTO , [dest_vol].*, sourcedate
      + dup [orig_vol].CAFEFIX  , [dest_vol].*, sourcedate
      + dup [orig_vol].CAFEFIXO , [dest_vol].*, sourcedate
      + dup [orig_vol].CRASSIGN , [dest_vol].*, sourcedate
      + dup [orig_vol].MCRI     , [dest_vol].*, sourcedate
      + dup [orig_vol].MCRO     , [dest_vol].*, sourcedate
      + dup [orig_vol].OBEYCEXT , [dest_vol].*, sourcedate
      + dup [orig_vol].OBEYCF1  , [dest_vol].*, sourcedate
      + dup [orig_vol].OBEYCF2  , [dest_vol].*, sourcedate
      + dup [orig_vol].OBEYCF3  , [dest_vol].*, sourcedate
      + dup [orig_vol].OBEYCF4  , [dest_vol].*, sourcedate
      + dup [orig_vol].MOVEP    , [dest_vol].*, sourcedate
      + exit
#unframe
